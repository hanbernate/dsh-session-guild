{
  "name": "dsh-session-guild",
  "version": "0.0.1",
  "description": "Quest publishing for DeepSeek Harness: hand a quest to a fresh ordinary session in another workspace or beside the current one, track it in a rebuildable cache, and let the contractor report a summary back as a background job result.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./compat.js": "./lib/compat.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "COMPATIBILITY.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "session",
    "sub-session",
    "workspace",
    "multi-workspace",
    "quest",
    "delegation",
    "automation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.1.5-rc.1"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && for f in lib/*.js lib/tools/*.js; do node --check \"$f\" || exit 1; done"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanbernate/dsh-session-guild.git"
  },
  "homepage": "https://github.com/hanbernate/dsh-session-guild",
  "bugs": {
    "url": "https://github.com/hanbernate/dsh-session-guild/issues"
  }
}
